# Clave pública de Web3Forms (web3forms.com). Va en el navegador por diseño.
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 (ID "G-XXXXXXX"). Vacío = el sitio no carga analítica ni muestra el aviso.
PUBLIC_GA_ID=
# Código de verificación de Google Search Console (solo el valor de content="...").
PUBLIC_GOOGLE_SITE_VERIFICATION=
