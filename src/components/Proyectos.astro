---
import { Image } from 'astro:assets'
import forja from '../assets/proyectos/forja.jpg'
import mcp from '../assets/proyectos/mcp-readiness-check.jpg'
import apis from '../assets/proyectos/apis-gratis-es.jpg'
import delivery from '../assets/demos/delivery.jpg'
import barberia from '../assets/demos/barberia.jpg'
import deportes from '../assets/demos/deportes.jpg'
import ferreteria from '../assets/demos/ferreteria.jpg'
import floristeria from '../assets/demos/floristeria.jpg'
import taxi from '../assets/demos/taxi.jpg'
const { t } = Astro.props
const p = t.proyectos
const capturas = { forja, 'mcp-readiness-check': mcp, 'apis-gratis-es': apis }
const miniaturas = { delivery, barberia, deportes, ferreteria, floristeria, taxi }
const dm = p.demos
const wa = `${t.whatsapp}?text=${encodeURIComponent(dm.ctaText)}`
---
<section id="proyectos" class="wrap">
  <div class="head">
    <div><h2>{p.title}</h2></div>
    <p>{p.sub}</p>
  </div>
  {p.items.map((it, i) => (
    <article class={'card proj' + (i === 0 ? ' destacado' : '')}>
      <div class="info">
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <h3>{it.id}</h3>
        <p>{it.description}</p>
        <div class="nums">{it.numbers.map((n) => <span>{n}</span>)}</div>
        <div class="row">
          {it.id === 'Forja' && it.demoUrl && <a class="btn dark" href={it.demoUrl} rel="noopener">{p.demoForja} ↗</a>}
          <a class={'btn ' + (it.id === 'Forja' ? 'line' : 'dark')} href={it.url} rel="noopener">{p.github}</a>
          {it.id !== 'Forja' && it.demoUrl && <a class="btn line" href={it.demoUrl} rel="noopener">{p.demo} ↗</a>}
        </div>
      </div>
      <div class="shot">
        {it.video
          ? <video class="anim" muted loop playsinline preload="none" poster={`/proyectos/${it.video}-poster.webp`} aria-label={it.shotAlt} width="640" height="360">
              <source src={`/proyectos/${it.video}.webm`} type="video/webm" />
              <source src={`/proyectos/${it.video}.mp4`} type="video/mp4" />
            </video>
          : <Image src={capturas[it.shot]} alt={it.shotAlt} widths={[480, 760, 1100]} sizes="(max-width: 820px) 100vw, 560px" loading="lazy" />}
      </div>
    </article>
  ))}
  <div class="demos" id={dm.id}>
    <div class="demos-head">
      <h3>{dm.title}</h3>
      <p>{dm.sub}</p>
    </div>
    <ul class="demo-grid">
      {dm.items.map((it) => (
        <li class="card demo">
          <a class="demo-thumb" href={it.demoUrl} rel="noopener" tabindex="-1" aria-hidden="true"><Image src={miniaturas[it.thumb]} alt={it.thumbAlt} widths={[400, 640]} sizes="(max-width: 820px) 100vw, 360px" loading="lazy" /></a>
          <h4>{it.name}</h4>
          <p>{it.description}</p>
          <div class="row"><a class="btn dark sm" href={it.demoUrl} rel="noopener">{dm.live} ↗</a><a class="btn line sm" href={it.url} rel="noopener">{dm.code}</a></div>
        </li>
      ))}
    </ul>
    <div class="card oferta">
      <div>
        <h4 class="mini">{dm.includesLabel}</h4>
        <ul class="incluye">{dm.includes.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h4 class="mini">{dm.stepsLabel}</h4>
        <ol class="pasos">{dm.steps.map((x) => <li>{x}</li>)}</ol>
      </div>
      <a class="btn wa" href={wa} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>{dm.cta}</a>
    </div>
  </div>
</section>
<script>
  import '../scripts/videos.js'
</script>
