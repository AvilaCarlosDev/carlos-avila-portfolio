---
// Página de contenido (servicio o caso): título, entrada, secciones y llamada a WhatsApp.
// Cada página existe en los dos idiomas; `clave` elige el contenido en t.paginas.
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
const { t, clave, otro, imagen, imagenAlt } = Astro.props
const pg = t.paginas[clave]
const alternates = t.lang === 'es' ? { es: pg.path, en: otro } : { es: otro, en: pg.path }
const wa = `${t.whatsapp}?text=${encodeURIComponent(pg.ctaText)}`
const externo = pg.link.href.startsWith('http')
const esExterno = (href) => href.startsWith('http')
// JSON-LD de la página: migas (Inicio > página) y el nodo que describe el servicio o la app.
const sitio = Astro.site.origin
const inicio = t.lang === 'es' ? '/' : '/en/'
const migas = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.lang === 'es' ? 'Inicio' : 'Home', item: new URL(inicio, sitio).href },
    { '@type': 'ListItem', position: 2, name: pg.title, item: new URL(pg.path, sitio).href },
  ],
}
const autor = { '@id': `${sitio}/#persona` }
const nodo = pg.schema && { ...pg.schema, url: new URL(pg.path, sitio).href, [pg.schema['@type'] === 'Service' ? 'provider' : 'author']: autor }
const esquema = nodo ? [migas, nodo] : [migas]
const ogImagen = imagen ? { src: imagen.src, width: imagen.width, height: imagen.height, alt: imagenAlt } : undefined
---
<Base t={t} path={pg.path} title={pg.metaTitle} description={pg.metaDescription} alternates={alternates} ogTipo={pg.ogTipo ?? 'website'} ogImagen={ogImagen} esquema={esquema}>
  <Header t={t} switchHref={otro} home={false} />
  <main id="contenido" class="pagina">
    <p class="eyebrow">{pg.eyebrow}</p>
    <h1>{pg.title}</h1>
    <p class="entrada">{pg.lead}</p>
    <div class="acciones">
      <a class="btn wa" href={wa} target="_blank" rel="noopener">{pg.cta}</a>
      <a class="btn line" href={pg.link.href} rel={externo ? 'noopener' : undefined}>{pg.link.label}{externo ? ' ↗' : ' →'}</a>
    </div>
    {imagen && <Image class="captura" src={imagen} alt={imagenAlt} widths={[480, 760]} sizes="(max-width: 820px) 100vw, 720px" loading="eager" fetchpriority="high" />}
    {pg.sections.map((s) => (
      <section>
        <h2>{s.h}</h2>
        <p>{s.p}</p>
        {s.list.length > 0 && <ul>{s.list.map((x) => <li>{x}</li>)}</ul>}
        {s.links?.length > 0 && <ul class="enlaces">{s.links.map((l) => <li><a href={l.href} rel={esExterno(l.href) ? 'noopener' : undefined}>{l.label}{esExterno(l.href) ? ' ↗' : ' →'}</a></li>)}</ul>}
      </section>
    ))}
    <div class="acciones final">
      <a class="btn wa" href={wa} target="_blank" rel="noopener">{pg.cta}</a>
    </div>
  </main>
  <Footer t={t} />
</Base>
