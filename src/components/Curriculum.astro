---
import { Image } from 'astro:assets'
import cvEs from '../assets/cv-es.jpg'
import cvEn from '../assets/cv-en.jpg'
import entrega from '../assets/cv-entrega.png'
const { t } = Astro.props
const c = t.cv
const miniatura = t.lang === 'es' ? cvEs : cvEn
---
<section id="cv" class="wrap">
  <div class="head">
    <div><h2>{c.title}</h2></div>
    <p>{c.sub}</p>
  </div>
  <div class="cvbox">
    <a class="thumb" href={c.primaryFile} download aria-label={c.btnPrimary}>
      <Image src={miniatura} alt={c.thumbAlt} widths={[320, 600]} sizes="300px" loading="lazy" />
      <span class="tag">{c.tag}</span>
    </a>
    <div class="cvtxt">
      <h3>{c.boxTitle}</h3>
      <p>{c.text}</p>
      <div class="cta" style="justify-content:flex-start">
        <a class="btn dark" href={c.primaryFile} download>⬇ {c.btnPrimary}</a>
        <a class="btn line" href={c.secondaryFile} download>⬇ {c.btnSecondary}</a>
      </div>
      <Image class="cvpj" src={entrega} alt={c.artAlt} height={250} loading="lazy" />
    </div>
  </div>
</section>
