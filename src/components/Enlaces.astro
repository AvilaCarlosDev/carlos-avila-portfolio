---
// Página del enlace de la bio (Instagram, Facebook, LinkedIn): dos caminos según quién llega
// y los proyectos que más se comparten. No se indexa: es una puerta de entrada, no contenido.
// La usan /links/ y /en/links/; los textos de cada idioma están aquí mismo.
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import retrato from '../assets/retrato.jpg'
import { siInstagram, siFacebook, siX, siThreads, siBluesky, siTiktok, siWhatsapp, siGithub, siBuymeacoffee } from 'simple-icons'

// simple-icons ya no trae LinkedIn (lo retiró a pedido de la marca): este es su logo oficial.
const siLinkedin = { hex: '0A66C2', path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' }

const { t } = Astro.props
const textos = {
  es: {
    path: '/links/',
    title: 'Carlos Avila · enlaces',
    description: 'Enlaces de Carlos Avila: webs y apps para negocios, CV para empresas y sus proyectos de homelab, IA local y seguridad.',
    skip: 'Saltar al contenido',
    retrato: 'Retrato de Carlos Avila',
    entrada: 'Developer | React · Node.js · Python. Construyo soluciones web y opero mi homelab, servicios e IA local. Privacidad, seguridad y control de datos.',
    caminos: 'Qué buscas',
    wa: 'Hola Carlos, vengo de tus redes y quiero hablar de mi negocio.',
    negocio: ['Tengo un negocio', 'Cuéntame qué vendes y te digo qué web o app haría'],
    empresa: ['Busco developer', 'CV, proyectos con cifras y contacto'],
    proyectos: 'Proyectos',
    redes: 'Redes',
    pagina: 'Página de Facebook',
    cafe: 'Invítame un café',
    lista: [
      { nombre: 'Forja', texto: 'App para entrenadores, en producción, con 109 pruebas de permisos', href: '/casos/forja/' },
      { nombre: 'polaris-local-ai', texto: 'IA local en una RX 580 de 8 GB, con benchmarks medidos', href: 'https://github.com/AvilaCarlosDev/polaris-local-ai' },
      { nombre: 'Webs de ejemplo', texto: 'Seis demos por rubro que reciben clientes por WhatsApp', href: '/#negocios' },
    ],
  },
  en: {
    path: '/en/links/',
    title: 'Carlos Avila · links',
    description: 'Links from Carlos Avila: websites and apps for businesses, CV for companies and his homelab, local AI and security projects.',
    skip: 'Skip to content',
    retrato: 'Portrait of Carlos Avila',
    entrada: 'Developer | React · Node.js · Python. I build web solutions and run my own homelab, services and local AI. Privacy, security and data ownership.',
    caminos: 'What are you looking for',
    wa: 'Hi Carlos, I found you on social media and want to talk about my business.',
    negocio: ['I have a business', 'Tell me what you sell and I’ll tell you what website or app I’d build'],
    empresa: ['Hiring a developer', 'CV, projects with numbers and contact'],
    proyectos: 'Projects',
    redes: 'Social',
    pagina: 'Facebook Page',
    cafe: 'Buy me a coffee',
    lista: [
      { nombre: 'Forja', texto: 'App for coaches, in production, with 109 permission tests', href: '/en/case-studies/forja/' },
      { nombre: 'polaris-local-ai', texto: 'Local AI on an 8 GB RX 580, with measured benchmarks', href: 'https://github.com/AvilaCarlosDev/polaris-local-ai' },
      { nombre: 'Sample websites', texto: 'Six demos by industry that bring in clients through WhatsApp', href: '/en/#negocios' },
    ],
  },
}
const x = textos[t.lang]
const otro = textos[t.lang === 'es' ? 'en' : 'es']
const inicio = t.lang === 'es' ? '/' : '/en/'
const wa = `${t.whatsapp}?text=${encodeURIComponent(x.wa)}`
const proyectos = x.lista
const redes = [
  { nombre: 'LinkedIn', href: 'https://www.linkedin.com/in/avilacarlosdev', icono: siLinkedin },
  { nombre: 'Instagram', href: 'https://www.instagram.com/avilacarlosdev', icono: siInstagram },
  { nombre: 'Facebook', href: 'https://www.facebook.com/AvilaCarlosDev', icono: siFacebook },
  { nombre: 'X', href: 'https://x.com/AvilaCarlosDev', icono: siX },
  { nombre: 'Threads', href: 'https://www.threads.com/@avilacarlosdev', icono: siThreads },
  { nombre: 'Bluesky', href: 'https://bsky.app/profile/avilacarlosdev.bsky.social', icono: siBluesky },
  { nombre: x.pagina, href: 'https://www.facebook.com/profile.php?id=61595597465729', icono: siFacebook },
  { nombre: 'TikTok', href: 'https://www.tiktok.com/@avilacarlosdev', icono: siTiktok },
  { nombre: 'WhatsApp Business', href: wa, icono: siWhatsapp },
  { nombre: 'GitHub', href: 'https://github.com/AvilaCarlosDev', icono: siGithub },
  { nombre: x.cafe, href: 'https://buymeacoffee.com/avilacarlosdev', icono: siBuymeacoffee, clase: 'cafe' },
]
const externo = (href) => href.startsWith('http')
// Los logos negros toman el color del texto para no perderse; el café va en su botón amarillo.
const color = (i) => (['000000', '181717', 'FFDD00'].includes(i.hex) ? 'currentColor' : `#${i.hex}`)
---
<Base
  t={t}
  path={x.path}
  title={x.title}
  description={x.description}
  alternates={{ es: textos.es.path, en: textos.en.path }}
  noindex
>
  <a class="skip" href="#contenido">{x.skip}</a>
  <main id="contenido" class="links">
    <div class="lang idioma" role="group" aria-label={t.nav.langLabel}>
      <b aria-current="true">{t.nav.current}</b> /
      <a href={otro.path} hreflang={t.nav.switchTo.hreflang} lang={t.nav.switchTo.hreflang} title={t.nav.switchTo.name}>{t.nav.switchTo.code}</a>
    </div>
    <Image class="foto" src={retrato} alt={x.retrato} widths={[96, 192]} sizes="96px" />
    <h1>AvilaCarlosDev</h1>
    <p class="entrada">{x.entrada}</p>

    <nav class="caminos" aria-label={x.caminos}>
      <a class="camino" href={wa} target="_blank" rel="noopener">
        <b>{x.negocio[0]}</b>
        <span>{x.negocio[1]}</span>
      </a>
      <a class="camino" href={`${inicio}#cv`}>
        <b>{x.empresa[0]}</b>
        <span>{x.empresa[1]}</span>
      </a>
    </nav>

    <h2>{x.proyectos}</h2>
    <ul class="proyectos">
      {proyectos.map((p) => (
        <li>
          <a href={p.href} target={externo(p.href) ? '_blank' : undefined} rel={externo(p.href) ? 'noopener' : undefined}>
            <b>{p.nombre}{externo(p.href) ? ' ↗' : ' →'}</b>
            <span>{p.texto}</span>
          </a>
        </li>
      ))}
    </ul>

    <h2>{x.redes}</h2>
    <nav class="redes" aria-label={x.redes}>
      {redes.map((r) => (
        <a class={r.clase} href={r.href} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d={r.icono.path} fill={color(r.icono)} /></svg>
          {r.nombre}
        </a>
      ))}
    </nav>
    <p class="web"><a href={inicio}>avilacarlosdev.com</a></p>
  </main>
</Base>

<style>
  .links { max-width: 520px; margin: 0 auto; padding: 24px 16px 64px; text-align: center; }
  .idioma { justify-content: flex-end; align-items: baseline; margin-bottom: 8px; }
  .idioma a { color: var(--mute); padding: 6px 4px; }
  .foto { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; margin: 0 auto 16px; display: block; }
  h1 { font-size: 40px; margin: 0 0 8px; }
  .entrada { color: var(--mute); font-size: 17px; margin: 0 0 28px; }
  .caminos { display: grid; gap: 12px; margin-bottom: 36px; }
  .camino { display: block; text-align: left; padding: 18px 20px; border-radius: 14px; background: var(--navy); color: #fff; text-decoration: none; }
  .camino:first-child { background: #25d366; color: #06260f; }
  .camino b { display: block; font-size: 18px; }
  .camino span { font-size: 14px; opacity: 0.85; }
  h2 { font-size: 26px; margin: 0 0 12px; text-align: left; }
  .proyectos { list-style: none; padding: 0; margin: 0 0 32px; display: grid; gap: 10px; text-align: left; }
  .proyectos a { display: block; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); color: var(--ink); text-decoration: none; }
  .proyectos a:hover { border-color: var(--blue); }
  .proyectos b { display: block; font-size: 16px; }
  .proyectos span { font-size: 14px; color: var(--mute); }
  .redes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 28px; }
  .redes a { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 12px 8px; white-space: nowrap; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--ink); text-decoration: none; font-size: 13.5px; font-weight: 500; }
  .redes a:hover { border-color: var(--blue); }
  .redes a:last-child { grid-column: 1 / -1; }
  .redes svg { flex: none; }
  .redes .cafe { background: #ffdd00; border-color: #ffdd00; color: #0d0c22; }
  .redes .cafe:hover { border-color: #0d0c22; }
  .web { font-size: 14px; }
  .web a { color: var(--mute); }
</style>
