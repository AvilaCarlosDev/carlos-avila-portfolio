---
const { t } = Astro.props
const p = t.porque
---
<section id="por-que" class="wrap">
  <div class="head">
    <div><div class="kick">{p.kick}</div><h2>{p.title}</h2></div>
    <p>{p.sub}</p>
  </div>
  <div class="grid2">
    {p.items.map((it, i) => (
      <article class="card why">
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <h3>{it.title}</h3>
        <p>{it.text}</p>
        <a class="more" href={it.href} rel={it.href.startsWith('http') ? 'noopener' : undefined}>{it.linkText} →</a>
      </article>
    ))}
  </div>
</section>
