---
import Base from '../layouts/Base.astro'
import Header from './Header.astro'
import Hero from './Hero.astro'
import Quien from './Quien.astro'
import Proyectos from './Proyectos.astro'
import Curriculum from './Curriculum.astro'
import Contacto from './Contacto.astro'
import Footer from './Footer.astro'
const { t, path } = Astro.props
---
<Base t={t} path={path}>
  <Header t={t} />
  <main id="contenido">
    <Hero t={t} />
    <Quien t={t} />
    <Proyectos t={t} />
    <Curriculum t={t} />
    <Contacto t={t} />
  </main>
  <Footer t={t} />
</Base>
